#. translators: 1: where in the file, 2: a label key such as details
#: modules/content-types/includes/class-schema.php:787
#, php-format
msgid "%1$s.%2$s must be a string or an object of locale → string."
msgstr ""
"%1$s.%2$s muss eine Zeichenkette oder ein Objekt Locale → Zeichenkette sein."

