#, php-format
msgid "%s.default must be a date as YYYY-MM-DD."
msgstr "%s.default muss ein Datum im Format JJJJ-MM-TT sein."

#. translators: %s: where in the file
#: modules/content-types/includes/class-schema.php:691
#, php-format
msgid "%s must be lowercase letters, digits and “_”, starting with a letter."
msgstr ""
"%s darf nur Kleinbuchstaben, Ziffern und „_“ enthalten und muss mit einem "
"Buchstaben beginnen."

#. translators: 1: where in the file, 2: the name, 3: max length, 4: its length
#: modules/content-types/includes/class-schema.php:696
#, php-format
msgid ""
"%1$s “%2$s” is longer than %3$d characters (%4$d): WordPress would cut it."
msgstr ""
"%1$s „%2$s“ ist länger als %3$d Zeichen (%4$d): WordPress würde es "
"abschneiden."

#. translators: 1: where in the file, 2: the name, 3: the prefix
#: modules/content-types/includes/class-schema.php:703
#, php-format
msgid "%1$s “%2$s” must start with the prefix “%3$s”."
msgstr "%1$s „%2$s“ muss mit dem Präfix „%3$s“ beginnen."

#. translators: 1: where in the file, 2: the name, 3: a reserved prefix
#: modules/content-types/includes/class-schema.php:708
#, php-format
msgid "%1$s “%2$s” uses the reserved prefix “%3$s”."
msgstr "%1$s „%2$s“ verwendet das reservierte Präfix „%3$s“."

#. translators: %s: where in the file
#: modules/content-types/includes/class-schema.php:729
#: modules/content-types/includes/class-schema.php:737
#, php-format
msgid ""
"%s must be a URL path (lowercase ASCII letters, digits, “-” and “/”, no "
"slashes at the ends) or an object of locale → such a path."
msgstr ""
"%s muss ein URL-Pfad sein (ASCII-Kleinbuchstaben, Ziffern, „-“ und „/“, ohne "
"Schrägstriche am Anfang oder Ende) oder ein Objekt Locale → ein solcher Pfad."

#. translators: %s: where in the file
#: modules/content-types/includes/class-schema.php:771
#, php-format
msgid "%s is required: {\"singular\": …, \"plural\": …}."
msgstr "%s ist erforderlich: {\"singular\": …, \"plural\": …}."

#. translators: %s: where in the file
#: modules/content-types/includes/class-schema.php:775
#, php-format
msgid "%s must be an object: {\"singular\": …, \"plural\": …}."
msgstr "%s muss ein Objekt sein: {\"singular\": …, \"plural\": …}."

#. translators: 1: where in the file, 2: singular or plural
#: modules/content-types/includes/class-schema.php:781
#, php-format
msgid "%1$s.%2$s is required: a string or an object of locale → string."
msgstr ""
"%1$s.%2$s ist erforderlich: eine Zeichenkette oder ein Objekt Locale → "
