#: modules/carousel/blocks/carousel/edit.js:60
msgid "Accessible name"
msgstr "Nom accessible"

#: modules/carousel/blocks/carousel/edit.js:61
msgid "Read by screen readers. Defaults to “Carousel”."
msgstr "El llegeixen els lectors de pantalla. Si es deixa buit: «Carrusel»."

