msgstr "Visibles a la tauleta"

#: modules/carousel/blocks/carousel/edit.js:83
msgid "Visible on desktop"
msgstr "Visibles a l'escriptori"

#: modules/carousel/blocks/carousel/edit.js:85
msgid "Autoplay"
msgstr "Reproducció automàtica"

#: modules/carousel/blocks/carousel/edit.js:86
msgid ""
"Off by default for accessibility. Ignored when the visitor asks for reduced "
"motion."
msgstr ""
"Desactivada per defecte per accessibilitat. No s'aplica si el visitant "
"demana reduir el moviment."

