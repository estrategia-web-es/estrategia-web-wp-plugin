msgid ""
"Invalid cookie name. Use the exact name, or a prefix ending in * for a "
"family of cookies (e.g. _ga_*)."
msgstr ""
"Nombre de cookie no válido. Usa el nombre exacto, o un prefijo acabado en * "
"para una familia de cookies (p. ej. _ga_*)."

