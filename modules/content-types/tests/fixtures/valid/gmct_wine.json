{
  "$schema": "../../../content-types.schema.json",
  "prefix": "gmct_",
  "name": "gmct_wine",
  "slug": "wines",
  "labels": { "singular": { "es": "Vino", "en": "Wine" }, "plural": { "es": "Vinos", "en": "Wines" } },
  "icon": "dashicons-carrot",
  "taxonomies": ["gmct_cuisine"],
  "fields": [
    { "name": "gmct_winery", "type": "relation", "label": "Restaurant", "post_type": "gmct_restaurant" },
    { "name": "gmct_vintage", "type": "number", "label": "Vintage", "integer": true, "min": 1900, "max": 2100, "required": true },
    { "name": "gmct_alcohol", "type": "number", "label": "Alcohol (%)", "min": 0, "max": 20 },
    { "name": "gmct_contact", "type": "email", "label": "Contact" },
    { "name": "gmct_label", "type": "image", "label": "Label" },
    { "name": "gmct_released", "type": "date", "label": "Released" },
    { "name": "gmct_organic", "type": "boolean", "label": "Organic" },
    { "name": "gmct_tasting", "type": "text", "label": "Tasting note" }
  ]
}
