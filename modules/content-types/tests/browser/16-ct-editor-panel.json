      "options": "[...document.querySelectorAll('[data-meta-key=\"llest_actes\"] [data-row=\"0\"] [data-sub=\"tipus\"] option')].map((o) => o.textContent)",
      "types": "['dia', 'hora', 'fins', 'lloc'].map((k) => document.querySelector('[data-meta-key=\"llest_actes\"] [data-row=\"0\"] [data-sub=\"' + k + '\"] input')?.type)",
      "buttons": "[...document.querySelectorAll('[data-meta-key=\"llest_actes\"] [data-row=\"0\"] button')].map((b) => b.textContent + '|' + b.getAttribute('aria-label') + '|' + (b.disabled || b.getAttribute('aria-disabled') === 'true'))",
      "focus": "document.activeElement.tagName"
    } } },
    { "type": "change", "selectors": ["[data-meta-key=\"llest_actes\"] [data-row=\"0\"] [data-sub=\"tipus\"] select"], "value": "Funeral" },
    { "type": "change", "selectors": ["[data-meta-key=\"llest_actes\"] [data-row=\"0\"] [data-sub=\"dia\"] input"], "value": "2026-11-25" },
