    } } },
    { "type": "click", "selectors": ["[data-meta-key=\"llest_actes\"] [data-action=\"add-row\"]"], "offsetX": 5, "offsetY": 5 },
    { "type": "waitForElement", "selectors": ["[data-meta-key=\"llest_actes\"] [data-row=\"0\"] [data-sub=\"tipus\"] select"] },
