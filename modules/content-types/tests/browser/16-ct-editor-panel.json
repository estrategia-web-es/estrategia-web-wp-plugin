    { "type": "change", "selectors": ["[data-meta-key=\"llest_actes\"] [data-row=\"1\"] [data-sub=\"dia\"] input"], "value": "2026-11-24" },
    { "type": "click", "selectors": ["[data-meta-key=\"llest_actes\"] [data-row=\"1\"] [data-action=\"move-up\"]"], "offsetX": 5, "offsetY": 5 },
    { "type": "waitForExpression", "expression": "document.querySelector('[data-meta-key=\"llest_actes\"] [data-row=\"0\"] [data-sub=\"tipus\"] select').value === 'Vetlla' && document.activeElement && document.activeElement.closest('[data-row=\"0\"]') !== null" },
    { "type": "customStep", "name": "capture", "parameters": { "label": "repeater-moved", "settle": [], "values": {
      "order": "[...document.querySelectorAll('[data-meta-key=\"llest_actes\"] [data-sub=\"tipus\"] select')].map((s) => s.value)",
      "legends": "[...document.querySelectorAll('[data-meta-key=\"llest_actes\"] [data-row] > legend')].map((l) => l.textContent)",
      "focus": "document.activeElement.closest('[data-row]')?.dataset.row + ':' + (document.activeElement.dataset.action || document.activeElement.tagName)"
    } } },
    { "type": "click", "selectors": ["[data-meta-key=\"llest_actes\"] [data-action=\"add-row\"]"], "offsetX": 5, "offsetY": 5 },
    { "type": "waitForElement", "selectors": ["[data-meta-key=\"llest_actes\"] [data-row=\"2\"] [data-action=\"remove-row\"]"] },
