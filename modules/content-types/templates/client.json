{
  "$schema": "../content-types.schema.json",
  "template": "client",
  "prefix": "eweb_",
  "name": "eweb_client",
  "slug": { "en": "clients", "es": "clientes", "ca": "clients" },
  "labels": {
    "singular": { "en": "Client", "es": "Cliente", "ca": "Client" },
    "plural": { "en": "Clients", "es": "Clientes", "ca": "Clients" },
    "details": { "en": "Client details", "es": "Datos del cliente", "ca": "Dades del client" },
    "featured_image": { "en": "Logo or photo", "es": "Logo o foto", "ca": "Logotip o foto" },
    "set_featured_image": { "en": "Set logo or photo", "es": "Poner logo o foto", "ca": "Posa un logotip o una foto" }
  },
  "icon": "dashicons-groups",
  "supports": ["title", "thumbnail", "excerpt", "page-attributes", "custom-fields"],
  "menu_position": 21,
  "wpml": "display-as-translated",
  "taxonomies": [
    {
      "name": "eweb_client_sector",
      "slug": { "en": "client-sector", "es": "sector", "ca": "sector" },
      "labels": {
        "singular": { "en": "Sector", "es": "Sector", "ca": "Sector" },
        "plural": { "en": "Sectors", "es": "Sectores", "ca": "Sectors" }
      },
      "hierarchical": true,
      "wpml": "display-as-translated"
    }
  ],
  "fields": [
    {
      "name": "client_url",
      "type": "url",
      "label": { "en": "Client website", "es": "Web del cliente", "ca": "Web del client" },
      "wpml": "copy"
    },
    {
      "name": "estrategia_web_client_image_fit",
      "type": "select",
      "label": { "en": "Image fit (cover for a photo, contain for a logo)", "es": "Encaje de la imagen (cover para una foto, contain para un logo)", "ca": "Encaix de la imatge (cover per a una foto, contain per a un logotip)" },
      "options": [
        { "value": "cover", "label": { "en": "Photo (fills the box, may be cropped)", "es": "Foto (llena el recuadro, puede recortarse)", "ca": "Foto (omple el requadre, es pot retallar)" } },
        { "value": "contain", "label": { "en": "Logo (whole, never cropped)", "es": "Logo (entero, nunca se recorta)", "ca": "Logotip (sencer, no es retalla mai)" } }
      ],
      "default": "cover",
      "wpml": "copy"
    },
    {
      "name": "estrategia_web_client_business_type",
      "type": "text",
      "label": { "en": "Business type", "es": "Tipo de negocio", "ca": "Tipus de negoci" },
      "help": { "en": "What the client does, e.g. “holiday rental agency”. It is translated; the name is not.", "es": "A qué se dedica el cliente, p. ej. «agencia de alquiler vacacional». Se traduce; el nombre no.", "ca": "A què es dedica el client, p. ex. «agència de lloguer turístic». Es tradueix; el nom, no." },
      "wpml": "translate"
    }
  ]
}
