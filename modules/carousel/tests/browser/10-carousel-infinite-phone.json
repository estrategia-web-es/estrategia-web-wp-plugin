    {"type":"waitForExpression","expression":"__settled('Carrusel en bucle con consulta', 5, 6)"},
    {"type":"customStep","name":"touch","parameters":{"selectors":[["aria/Carrusel en bucle con consulta[role=\"region\"]",".estrategia-web-carousel__track"]],"dx":-260}},
    {"type":"waitForExpression","expression":"__settled('Carrusel en bucle con consulta', 0, 6)"},
    {"type":"customStep","name":"capture","parameters":{"label":"phone","save":["console"],"values":{"trips":"window.__trips"}}}
