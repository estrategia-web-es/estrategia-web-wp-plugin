    {"type":"customStep","name":"scrollIntoView","parameters":{"selectors":["aria/Carrusel en bucle[role=\"region\"]"]}},
    {"type":"waitForExpression","expression":"__track('Carrusel en bucle').closest('.estrategia-web-carousel').classList.contains('is-ready')"},
