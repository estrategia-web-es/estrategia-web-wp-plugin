    {"type":"waitForExpression","expression":"__settled('Carrusel con una de más', 2, 3)"},
    {"type":"customStep","name":"run","parameters":{"expression":"__end('Carrusel con una de más', 'Carrusel con una de más on mobile, from 1 to 3', 3, -1, true, 2)"}},
    {"type":"customStep","name":"run","parameters":{"expression":"__rec('Carrusel con una de más')"}},
    {"type":"click","selectors":[["aria/Carrusel con una de más[role=\"region\"]","aria/Diapositiva siguiente[role=\"button\"]"]],"offsetX":10,"offsetY":10},
