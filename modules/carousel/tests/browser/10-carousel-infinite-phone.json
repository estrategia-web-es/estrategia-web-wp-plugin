    {"type":"setViewport","width":402,"height":860,"deviceScaleFactor":1,"isMobile":true,"hasTouch":true,"isLandscape":false},
    {"type":"navigate","url":"/prueba-carrusel-bucle/"},
    {"type":"customStep","name":"scrollIntoView","parameters":{"selectors":["aria/Carrusel con una de más[role=\"region\"]"]}},
