{
  "title": "Infinite carousel with «reduce motion»: it wraps around the same, without animation and without going back",
  "description": "Infinite estrategia-web/carousel on /prueba-carrusel-bucle/ with prefers-reduced-motion: «Carrusel con una de más» forward across the seam and back across it, and «Carrusel en bucle» «next» on the last slide; each trip recorded: the right slide, never back, and the position changes once (no animation). Read by browser-carousel-infinite-calm. It was carousel-infinite.test.mjs (section 7, level 3) until 29-10-2026.",
  "writes": true,
  "initScripts": [
    "modules/carousel/tests/browser/probes.js"
  ],
  "emulate": {
    "reducedMotion": "reduce"
  },
  "steps": [
    {"type":"customStep","name":"setup","parameters":{"requests":[{"path":"/estrategia-web-site-test/v1/setup","body":{"modules":["carousel","map","whatsapp","language-switcher"]}},{"path":"/estrategia-web-carousel-test/v1/seed","method":"POST"}]}},
    {"type":"setViewport","width":1200,"height":900,"deviceScaleFactor":1,"isMobile":false,"hasTouch":false,"isLandscape":false},
    {"type":"navigate","url":"/prueba-carrusel-bucle/"},
    {"type":"customStep","name":"scrollIntoView","parameters":{"selectors":["aria/Carrusel con una de más[role=\"region\"]"]}},
    {"type":"waitForExpression","expression":"__track('Carrusel con una de más').closest('.estrategia-web-carousel').classList.contains('is-ready')"},
    {"type":"waitForExpression","expression":"__settled('Carrusel con una de más', 0, 3)"},
    {"type":"customStep","name":"run","parameters":{"expression":"__rec('Carrusel con una de más')"}},
    {"type":"click","selectors":[["aria/Carrusel con una de más[role=\"region\"]","aria/Diapositiva siguiente[role=\"button\"]"]],"offsetX":10,"offsetY":10},
    {"type":"waitForExpression","expression":"__settled('Carrusel con una de más', 1, 3)"},
    {"type":"customStep","name":"run","parameters":{"expression":"__end('Carrusel con una de más', 'Carrusel con una de más with \\'reduce motion\\', from 1 to 2', 3, 1, false, 1)"}},
    {"type":"customStep","name":"run","parameters":{"expression":"__rec('Carrusel con una de más')"}},
    {"type":"click","selectors":[["aria/Carrusel con una de más[role=\"region\"]","aria/Diapositiva siguiente[role=\"button\"]"]],"offsetX":10,"offsetY":10},
    {"type":"waitForExpression","expression":"__settled('Carrusel con una de más', 2, 3)"},
    {"type":"customStep","name":"run","parameters":{"expression":"__end('Carrusel con una de más', 'Carrusel con una de más with \\'reduce motion\\', from 2 to 3', 3, 1, false, 2)"}},
    {"type":"customStep","name":"run","parameters":{"expression":"__rec('Carrusel con una de más')"}},
    {"type":"click","selectors":[["aria/Carrusel con una de más[role=\"region\"]","aria/Diapositiva siguiente[role=\"button\"]"]],"offsetX":10,"offsetY":10},
    {"type":"waitForExpression","expression":"__settled('Carrusel con una de más', 0, 3)"},
    {"type":"customStep","name":"run","parameters":{"expression":"__end('Carrusel con una de más', 'Carrusel con una de más with \\'reduce motion\\', from 3 to 1', 3, 1, false, 0)"}},
    {"type":"customStep","name":"run","parameters":{"expression":"__rec('Carrusel con una de más')"}},
    {"type":"click","selectors":[["aria/Carrusel con una de más[role=\"region\"]","aria/Diapositiva anterior[role=\"button\"]"]],"offsetX":10,"offsetY":10},
    {"type":"waitForExpression","expression":"__settled('Carrusel con una de más', 2, 3)"},
    {"type":"customStep","name":"run","parameters":{"expression":"__end('Carrusel con una de más', 'Carrusel con una de más with \\'reduce motion\\', from 1 to 3', 3, -1, false, 2)"}},
    {"type":"customStep","name":"scrollIntoView","parameters":{"selectors":["aria/Carrusel en bucle[role=\"region\"]"]}},
    {"type":"waitForExpression","expression":"__track('Carrusel en bucle').closest('.estrategia-web-carousel').classList.contains('is-ready')"},
    {"type":"waitForExpression","expression":"__settled('Carrusel en bucle', 0, 5)"},
    {"type":"click","selectors":[["aria/Carrusel en bucle[role=\"region\"]","aria/Ir a la diapositiva 5[role=\"button\"]"]],"offsetX":10,"offsetY":10},
    {"type":"waitForExpression","expression":"__settled('Carrusel en bucle', 4, 5)"},
    {"type":"customStep","name":"run","parameters":{"expression":"__rec('Carrusel en bucle')"}},
    {"type":"click","selectors":[["aria/Carrusel en bucle[role=\"region\"]","aria/Diapositiva siguiente[role=\"button\"]"]],"offsetX":10,"offsetY":10},
    {"type":"waitForExpression","expression":"__settled('Carrusel en bucle', 0, 5)"},
    {"type":"customStep","name":"run","parameters":{"expression":"__end('Carrusel en bucle', 'Carrusel en bucle with \\'reduce motion\\', \\'next\\' on the last, from 5 to 1', 5, 1, false, 0)"}},
    {"type":"customStep","name":"capture","parameters":{"label":"calm","save":["console"],"values":{"trips":"window.__trips"}}}
  ]
}
