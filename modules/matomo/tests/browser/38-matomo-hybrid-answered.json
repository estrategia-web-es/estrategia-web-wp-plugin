{
  "title": "Matomo HYBRID, the notice already answered: Matomo remembers on load without anyone clicking",
  "description": "Matomo in hybrid mode with the notice's cookie already stored (Analytics accepted, with the CURRENT revision: md5(\"statistics,maps|1\") — statistics from Matomo plus maps from «the theme»; the trap: built from statistics alone it is another revision): mtm_cookie_consent appears on load and the notice does not show. Read by browser-matomo-hybrid-answered. It was the «answered» visitor of test 2 of matomo-browser.test.mjs (level 3) until 29-10-2026.",
  "writes": true,
  "network": {
    "foreign": "abort",
    "fulfill": [
      { "url": "^https://stats\\.ejemplo\\.test/.*matomo\\.js", "status": 200, "contentType": "application/javascript", "body": "@repo/modules/matomo/tests/fixtures/matomo.js" },
      { "url": "^https://stats\\.ejemplo\\.test/", "status": 204 }
    ]
  },
  "steps": [
    { "type": "customStep", "name": "setup", "parameters": { "requests": [
      { "path": "/estrategia-web-site-test/v1/setup", "body": {} }
    ] } },
    { "type": "setViewport", "width": 1200, "height": 900, "deviceScaleFactor": 1, "isMobile": false, "hasTouch": false, "isLandscape": false },
    { "type": "customStep", "name": "cookies", "parameters": { "set": [{ "name": "estrategia_web_consent", "value": "8d6a64a0.statistics.{{@now}}" }] } },
    { "type": "navigate", "url": "/?ew-options=%7B%22estrategia_web_site%22%3A%7B%22matomo_url%22%3A%22https%3A%2F%2Fstats.ejemplo.test%2F%22%2C%22matomo_site_id%22%3A3%2C%22matomo_mode%22%3A%22hybrid%22%7D%7D&ew-consent-setup=%7B%22categories%22%3A%5B%22maps%22%5D%7D" },
    { "type": "waitForExpression", "expression": "document.cookie.split('; ').some((c) => c.startsWith('mtm_cookie_consent='))" },
    { "type": "customStep", "name": "capture", "parameters": {
      "label": "remembered",
      "save": ["cookies"],
      "values": { "noticeHidden": "(() => { const n = document.getElementById('estrategia-web-consent'); return !n || !(n.getBoundingClientRect().width && n.checkVisibility()); })()" }
    } }
  ]
}
