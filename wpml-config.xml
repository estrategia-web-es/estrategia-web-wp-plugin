<?xml version="1.0" encoding="UTF-8"?>
<!--
	Which block attributes WPML translates when a page is translated.

	WPML reads this file by itself, from the plugin root; without WPML it does
	nothing. That is why there is ONE for all modules (1.1.0; until then it
	belonged to the forms plugin): a module with attributes to translate adds
	its <gutenberg-block> entries here, in the same commit as the module. It is
	one of the three shared files (see includes/class-modules.php). What
	follows belongs to the forms module.

	How to maintain:
	- A new attribute that a person reads (visitor or recipient of an email)
	  goes in here in the same commit as in block.json.
	- Edge case: the recipient of a notification («to») is NOT translated, so
	  the translator cannot redirect the emails. If a site needs a different
	  recipient per language, it is set by hand on the translated page.
	  «name» and «formId» are not translated either: they are keys, and
	  translating them would split the submissions log and the placeholders.
	  The dropdown's «defaultOption» is not either: it is the POSITION of the
	  option, and since «options» is translated line by line without changing
	  the order, the translated page preselects the same option on its own
	  (see includes/class-preselect.php). A translator who reorders the
	  options shifts it.
	- The trap: the texts used by default when the attribute is empty (the
	  «Enviar» button, the consent) do NOT go through here, they come from the
	  .po. If they are filled in on the original site, then they do have to be
	  translated here.
-->
<wpml-config>
	<gutenberg-blocks>
		<gutenberg-block type="estrategia-web-forms/form" translate="1">
			<key name="successMessage" />
			<key name="errorMessage" />
		</gutenberg-block>
		<gutenberg-block type="estrategia-web-forms/text" translate="1">
			<key name="label" />
			<key name="placeholder" />
		</gutenberg-block>
		<gutenberg-block type="estrategia-web-forms/email" translate="1">
			<key name="label" />
			<key name="placeholder" />
		</gutenberg-block>
		<gutenberg-block type="estrategia-web-forms/tel" translate="1">
			<key name="label" />
			<key name="placeholder" />
		</gutenberg-block>
		<gutenberg-block type="estrategia-web-forms/textarea" translate="1">
			<key name="label" />
			<key name="placeholder" />
		</gutenberg-block>
		<gutenberg-block type="estrategia-web-forms/select" translate="1">
			<key name="label" />
			<key name="placeholder" />
			<key name="options" />
		</gutenberg-block>
		<gutenberg-block type="estrategia-web-forms/checkbox" translate="1">
			<key name="label" />
			<key name="privacyUrl" />
		</gutenberg-block>
		<gutenberg-block type="estrategia-web-forms/submit" translate="1">
			<key name="text" />
		</gutenberg-block>
		<gutenberg-block type="estrategia-web-forms/notification" translate="1">
			<key name="subject" />
			<key name="body" />
		</gutenberg-block>
	</gutenberg-blocks>
	<!--
		Site module (unpublished): the location, client and testimonial metas.
		The criterion (copy = the same in every language; translate = text
		that is read) and the edge case are in
		modules/site/includes/class-meta-panel.php; Meta_Panel::WPML_COPY /
		WPML_TRANSLATE say the same, and the test
		modules/site/tests/meta-panel.test.mjs fails if they do not match.
	-->
	<custom-fields>
		<custom-field action="copy">estrategia_web_location_phone</custom-field>
		<custom-field action="copy">estrategia_web_location_email</custom-field>
		<custom-field action="copy">estrategia_web_location_map_url</custom-field>
		<custom-field action="copy">estrategia_web_location_map_embed</custom-field>
		<custom-field action="copy">estrategia_web_location_static_map</custom-field>
		<custom-field action="copy">estrategia_web_location_static_map_id</custom-field>
		<custom-field action="translate">estrategia_web_location_address</custom-field>
		<custom-field action="translate">estrategia_web_location_schedule</custom-field>
		<custom-field action="copy">client_url</custom-field>
		<custom-field action="copy">estrategia_web_client_image_fit</custom-field>
		<custom-field action="translate">estrategia_web_client_business_type</custom-field>
		<custom-field action="copy">estrategia_web_testimonial_author</custom-field>
		<custom-field action="translate">testimonial_role</custom-field>
		<custom-field action="copy">estrategia_web_testimonial_rating</custom-field>
		<custom-field action="copy">testimonial_client</custom-field>
	</custom-fields>
	<!--
		Social module (unpublished): name and link of each network, by
		POSITION in the list («*» is the index). Reordering the list shifts the
		translations; see modules/social/includes/class-links.php. icon and
		icon_id are not translated: they are the same drawing in every
		language.
	-->
	<admin-texts>
		<key name="estrategia_web_social_links">
			<key name="*">
				<key name="name" />
				<key name="url" />
			</key>
		</key>
	</admin-texts>
</wpml-config>
